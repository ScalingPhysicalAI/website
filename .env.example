# Shopify Storefront API
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
PUBLIC_SHOPIFY_API_VERSION=2024-01

# Visitor analytics. Leave PROVIDER blank to disable entirely - no tracking
# script is emitted, which is what you want locally so dev traffic stays out of
# the real numbers. Set these as Vercel project environment variables for production.
#   umami      -> SITE_ID is the website ID (a UUID) from the Umami dashboard
#   plausible  -> SITE_ID is the bare domain you registered, e.g. example.com
#   cloudflare -> SITE_ID is the beacon token
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_SITE_ID=
# Only needed if you self-host Umami or Plausible. Origin with no trailing
# slash, e.g. https://analytics.example.com. Leave blank to use the vendor cloud.
PUBLIC_ANALYTICS_HOST=

# GoAffPro affiliate tracking (custom-storefront integration). Leave blank to
# disable - no loader script is emitted, so local/dev traffic isn't tracked.
# Find the key in GoAffPro: Settings -> Developer -> Debug Integration, in the
# loader.js URL's `shop` query param.
PUBLIC_GOAFFPRO_SHOP_KEY=

# Resend credentials used by /api/partner-agreement to email the signed
# Buildo Creators partner agreement + LOI. Set as Vercel project environment
# variables (server-only, never exposed to the client). Get a key from
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to the shared
# onboarding@resend.dev sender if left blank.
RESEND_FROM=
# Who receives the signed PDFs for StarForge to countersign.
PARTNER_NOTIFY_EMAIL=vipulsaini594@gmail.com
